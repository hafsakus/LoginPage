@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginPage.Models.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null; // Sayfayı bağımsız tam ekran yapar
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome İkonları -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            overflow: hidden;
            width: 100%;
            max-width: 420px;
            padding: 40px 30px;
            transition: transform 0.3s ease;
        }

            .login-card:hover {
                transform: translateY(-5px);
            }

        .brand-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin: 0 auto 20px;
            box-shadow: 0 8px 20px rgba(118, 75, 162, 0.3);
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 15px 12px 45px;
            border: 1px solid #e1e1e1;
            font-size: 14px;
        }

            .form-control:focus {
                border-color: #764ba2;
                box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.15);
            }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

            .input-group-custom i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #a0a0a0;
                z-index: 10;
                font-size: 16px;
            }

        .btn-login {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            color: #fff;
            width: 100%;
            font-size: 16px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(118, 75, 162, 0.4);
        }

            .btn-login:hover {
                background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
                box-shadow: 0 8px 25px rgba(118, 75, 162, 0.6);
                transform: translateY(-2px);
            }

        .forgot-link {
            color: #764ba2;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .form-check-label {
            font-size: 13px;
            color: #666;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Üst Yuvarlak İkon -->
        <div class="brand-icon">
            <i class="fa-solid fa-user-lock"></i>
        </div>

        <h4 class="text-center fw-bold mb-1" style="color: #333;">Hoş Geldiniz</h4>
        <p class="text-center text-muted small mb-4">Lütfen bilgilerinizi girerek devam edin</p>

        <form asp-controller="Account" asp-action="Login" method="post">
            <!-- Genel Hata Mesajı -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center"></div>

            <!-- E-Posta İkonlu Kutucuk -->
            <div class="input-group-custom">
                <i class="fa-solid fa-envelope"></i>
                <input asp-for="UsernameOrEmail" class="form-control" placeholder="Kullanıcı adı veya E-posta Adresi" />
                <span asp-validation-for="UsernameOrEmail" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- Şifre İkonlu Kutucuk -->
            <div class="input-group-custom">
                <i class="fa-solid fa-lock"></i>
                <input asp-for="Password" class="form-control" placeholder="Şifre" />
                <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- Beni Hatırla & Şifremi Unuttum -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check m-0">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberCheck" />
                    <label class="form-check-label" for="rememberCheck">Beni Hatırla</label>
                </div>
                <a href="#" class="forgot-link">Şifremi Unuttum?</a>
            </div>

            <!-- Giriş Butonu -->
            <button type="submit" class="btn btn-login">
                Giriş Yap <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
        </form>
    </div>

</body>
</html>