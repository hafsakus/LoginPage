@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginPage.Models.Assignment

@{
    ViewData["Title"] = "Ödevi Düzenle";
}

<!-- Bootstrap 5 CDN & İkonlar -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    * {
        font-family: 'Poppins', sans-serif;
    }

    body {
        background-color: #f8f9fa;
    }

    .card-custom {
        background: white;
        border-radius: 16px;
        padding: 30px;
        border: 1px solid #eef2f5;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        max-width: 600px;
        margin: 40px auto;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            color: white;
            opacity: 0.9;
            transform: translateY(-2px);
        }

    .form-control, .form-select {
        border-radius: 10px;
        padding: 10px 14px;
        border: 1px solid #dee2e6;
    }

        .form-control:focus, .form-select:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.15);
        }
</style>

<div class="container py-4">
    <div class="card-custom">
        <div class="d-flex align-items-center mb-4">
            <div class="me-3 rounded-circle d-flex align-items-center justify-content-center text-white"
                 style="width: 45px; height: 45px; background: linear-gradient(135deg, #667eea, #764ba2);">
                <i class="fa-solid fa-pen-to-square fs-5"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-dark">Ödevi Düzenle</h4>
                <small class="text-muted">Ödev bilgilerini güncelleyin</small>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            <!-- KRİTİK: Düzenlenecek ödevin ID'sini gizli tutuyoruz -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <!-- Ders Adı -->
            <div class="mb-3">
                <label asp-for="ClassName" class="form-label fw-medium text-secondary">Ders / Konu Adı</label>
                <input asp-for="ClassName" class="form-control" placeholder="Örn: Python Programlama" />
                <span asp-validation-for="ClassName" class="text-danger small"></span>
            </div>

            <!-- Ödev Başlığı -->
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-medium text-secondary">Ödev Başlığı</label>
                <input asp-for="Title" class="form-control" placeholder="Örn: If-Else Projesi" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <!-- Açıklama -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-medium text-secondary">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ödev detayları..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Son Teslim Tarihi -->
            <div class="mb-3">
                <label asp-for="DueDate" class="form-label fw-medium text-secondary">Son Teslim Tarihi</label>
                <input asp-for="DueDate" type="date" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>

            <!-- Durum -->
            <div class="mb-4">
                <label asp-for="Status" class="form-label fw-medium text-secondary">Durum</label>
                <select asp-for="Status" class="form-select">
                    <option value="Yapılacak">Yapılacak</option>
                    <option value="Devam Ediyor">Devam Ediyor</option>
                    <option value="Tamamlandı">Tamamlandı</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <!-- Butonlar -->
            <div class="d-flex justify-content-between align-items-center pt-2">
                <a asp-action="Index" class="btn btn-light border text-secondary px-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> Geri Dön
                </a>
                <button type="submit" class="btn btn-gradient">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>