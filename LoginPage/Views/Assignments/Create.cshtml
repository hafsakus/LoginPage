@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginPage.Models.Assignment

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yeni Ödev Ekle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">➕ Yeni Ödev Ekle</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">

                    <!-- 1. Ders Adı Kutusunda ClassName Bağlı Olmalı -->
                    <div class="mb-3">
                        <label class="form-label">Ders Adı</label>
                        <input asp-for="ClassName" name="ClassName" class="form-control" placeholder="Örn: Python, C#" required />
                    </div>

                    <!-- 2. Ödev Başlığı Kutusunda Title Bağlı Olmalı -->
                    <div class="mb-3">
                        <label class="form-label">Ödev Başlığı / Konusu</label>
                        <input asp-for="Title" name="Title" class="form-control" placeholder="Örn: If Else Projesi" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Açıklama (Opsiyonel)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ödevle ilgili detaylar..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DueDate" class="form-label">Son Teslim Tarihi</label>
                        <input asp-for="DueDate" type="date" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Başlangıç Durumu</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Yapılacak">Yapılacak</option>
                            <option value="Devam Ediyor">Devam Ediyor</option>
                            <option value="Tamamlandı">Tamamlandı</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                        <button type="submit" class="btn btn-success">Ödevi Kaydet</button>
                    </div>

                </form>
            </div>
        </div>
    </div>

</body>
</html>
